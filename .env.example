APP_NAME="Intuition Island"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database/database.sqlite
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Credit purchases: sandbox only. Store real credentials only in .env.
STRIPE_ENABLED=false
STRIPE_TEST_SECRET=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_MINIMUM_CENTAVOS=100
PAYPAL_ENABLED=false
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_SECRET=
PAYPAL_SANDBOX_WEBHOOK_ID=
PAYPAL_MINIMUM_CENTAVOS=100
MAYA_ENABLED=false
MAYA_SANDBOX_PUBLIC_KEY=
MAYA_SANDBOX_SECRET_KEY=
MAYA_MINIMUM_CENTAVOS=100
GCASH_ENABLED=false
PAYMONGO_TEST_SECRET=
PAYMONGO_TEST_WEBHOOK_SECRET=
GCASH_MINIMUM_CENTAVOS=100

# Local Reverb credentials: replace before exposing a deployment.
REVERB_APP_ID=intuition-island-local
REVERB_APP_KEY=local-example-key
REVERB_APP_SECRET=local-example-secret-change-me
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=*
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Optional hosted email delivery using Laravel's Resend mailer.
RESEND_API_KEY=

# Free, closed-corpus site guide. The Together API key stays only in .env.
ASSISTANT_ENABLED=false
TOGETHER_API_KEY=
TOGETHER_ASSISTANT_MODEL=Qwen/Qwen3.5-9B
ASSISTANT_TIMEOUT_SECONDS=12
ASSISTANT_MAX_OUTPUT_TOKENS=220
ASSISTANT_PORT=8011
ASSISTANT_RAG_URL=http://127.0.0.1:8011/ask
