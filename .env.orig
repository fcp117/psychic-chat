# Safe reference template. Put machine-specific values only in the ignored .env file.
APP_NAME="Intuition Island"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=reverb

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

PAYMONGO_ENABLED=false
PAYMONGO_TEST_SECRET=
PAYMONGO_TEST_WEBHOOK_SECRET=
PAYMONGO_MINIMUM_CENTAVOS=100
PAYMONGO_PAYMENT_METHOD_TYPES=card

REVERB_APP_ID=intuition-island-local
REVERB_APP_KEY=local-example-key
REVERB_APP_SECRET=local-example-secret-change-me
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=*
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

ASSISTANT_ENABLED=false
TOGETHER_API_KEY=
TOGETHER_ASSISTANT_MODEL=Qwen/Qwen3.5-9B
ASSISTANT_TIMEOUT_SECONDS=12
ASSISTANT_MAX_OUTPUT_TOKENS=220
