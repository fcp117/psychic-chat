# Safe automated-test environment. No real account, email, payment, or AI key belongs here.
APP_NAME="Intuition Island Tests"
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

DB_CONNECTION=sqlite
DB_DATABASE=:memory:
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
MAIL_MAILER=array
RESEND_API_KEY=

PAYMONGO_ENABLED=false
PAYMONGO_TEST_SECRET=
PAYMONGO_TEST_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_METHOD_TYPES=card
ASSISTANT_ENABLED=false
TOGETHER_API_KEY=
REVERB_ALLOWED_ORIGINS=*
